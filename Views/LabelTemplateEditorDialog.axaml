<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrintToolAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PrintToolAvalonia.Views.LabelTemplateEditorDialog"
        x:DataType="vm:LabelTemplateEditorViewModel"
        Title="模板编辑器"
        Width="1360"
        Height="860"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <Border Grid.Row="0" Classes="card" Padding="15" Margin="0,0,0,15">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{Binding DialogTitle}" Classes="section-title"/>
                    <TextBlock Text="左侧编辑模板配置，右侧实时预览最终打印效果。预览与正式打印使用同一套模板生成逻辑。"
                               Classes="secondary"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox Grid.Column="1"
                          IsChecked="{Binding IncludeImporterInfo}"
                          Content="预览包含进口商信息"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,1.2*" ColumnSpacing="15">
            <Border Grid.Column="0" Classes="card" Padding="15">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <TextBlock Grid.Row="0" Text="模板 JSON" Classes="section-title"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding TemplateJsonText}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"/>
                    <Border Grid.Row="2"
                            Background="#F5F7FA"
                            BorderBrush="#E4E7ED"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <TextBlock Text="请编辑可直接保存的模板配置。右侧显示的是最终打印样式预览，而不是 JSON 文本预览。"
                                   Classes="secondary"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="15">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="打印效果预览" Classes="section-title"/>
                            <TextBlock Text="{Binding PreviewStatusMessage}" Classes="secondary" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="刷新预览"
                                Command="{Binding RefreshPreviewCommand}"
                                Classes="secondary"
                                MinWidth="100"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#F0F2F5"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="16">
                                <Border Background="White"
                                        BoxShadow="0 2 12 0 #40000000"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Padding="0"
                                        CornerRadius="2">
                                    <Image Source="{Binding PreviewImage}"
                                           Stretch="Uniform"
                                           MaxWidth="520"
                                           MinWidth="320"
                                           IsVisible="{Binding !IsPreviewLoading}"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                </Border>
                            </ScrollViewer>

                            <Border Background="#CC000000"
                                    CornerRadius="8"
                                    IsVisible="{Binding IsPreviewLoading}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="160"
                                                 Height="4"/>
                                    <TextBlock Text="预览生成中..."
                                               Foreground="White"
                                               FontSize="14"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="12">
                        <Border Background="#F0F2F5"
                                CornerRadius="4"
                                Padding="10,6">
                            <TextBlock Text="{Binding LabelSizeText}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="#E8F5E9"
                                CornerRadius="4"
                                Padding="10,6">
                            <TextBlock Text="300 DPI 高清预览"
                                       FontSize="12"
                                       Foreground="#2E7D32"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,15,0,0">
            <TextBlock Grid.Column="0"
                      Text="{Binding PreviewStatusMessage}"
                      VerticalAlignment="Center"
                      Classes="secondary"
                      TextWrapping="Wrap"/>
            <Button Grid.Column="1"
                    Content="取消"
                    Command="{Binding CancelCommand}"
                    Classes="secondary"
                    MinWidth="100"/>
            <Button Grid.Column="2"
                    Command="{Binding SaveCommand}"
                    Classes="accent"
                    MinWidth="120"
                    IsEnabled="{Binding !IsSaving}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="保存模板" IsVisible="{Binding !IsSaving}"/>
                        <TextBlock Text="保存中..." IsVisible="{Binding IsSaving}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
    </Grid>
</Window>
